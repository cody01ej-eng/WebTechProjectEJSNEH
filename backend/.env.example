# Azure App Service / production-oriented backend settings
SPRING_PROFILES_ACTIVE=
SERVER_PORT=8080

DB_URL=jdbc:mysql://your-mysql-server.mysql.database.azure.com:3306/project_pulse?useSSL=true&requireSSL=true
DB_USERNAME=projectpulse
DB_PASSWORD=change-me

ALLOWED_ORIGINS=https://your-frontend-app.azurestaticapps.net
REQUIRE_HTTPS=true
SESSION_COOKIE_NAME=PROJECT_PULSE_SESSION
SESSION_COOKIE_SAME_SITE=none
SESSION_COOKIE_SECURE=true
SESSION_TIMEOUT=30m

APP_EMAIL_ENABLED=false
APP_EMAIL_BASE_URL=https://your-frontend-app.azurestaticapps.net
APP_EMAIL_FROM_ADDRESS=noreply@projectpulse.example
APP_EMAIL_FROM_NAME=Project Pulse Team
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_ALLOW_NONLOCAL=false
BOOTSTRAP_ADMIN_EMAIL=admin@projectpulse.local
BOOTSTRAP_ADMIN_PASSWORD=Admin123!
BOOTSTRAP_ADMIN_FIRST_NAME=Project
BOOTSTRAP_ADMIN_LAST_NAME=Pulse Admin
